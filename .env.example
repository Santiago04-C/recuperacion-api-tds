# Database URLs
# Para desarrollo local con SQLite (recomendado):
DATABASE_URL="file:./dev.db"

# Para producción con PostgreSQL (Neon, Railway, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# MongoDB para logs
MONGODB_URI="mongodb://localhost:27017/logs_db"
# Para MongoDB Atlas en producción:
# MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/logs_db?retryWrites=true&w=majority"

# JWT Secret (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET="tu-secret-super-seguro-cambialo-en-produccion-12345"

# Node Environment
NODE_ENV="development"
